{
  "name": "reservasi-layanan-backend",
  "version": "1.0.0",
  "description": "Backend API untuk Sistem Reservasi Layanan",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest --runInBand --forceExit",
    "test:coverage": "jest --coverage --runInBand --forceExit",
    "test:bdd": "cucumber-js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "express-validator": "^7.0.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.3.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.3",
    "supertest": "^6.3.4",
    "chai": "^4.4.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/unit/**/*.test.js"],
    "collectCoverageFrom": ["src/**/*.js"]
  }
}
