    {
      "name": "TC-API-13: GET /api/orders/:id - Detail pesanan",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code 200', () => pm.response.to.have.status(200));",
              "pm.test('Detail pesanan lengkap', () => {",
