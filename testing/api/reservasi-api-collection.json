              "  pm.expect(json.success).to.be.true;",
              "  pm.expect(parseInt(json.data.stock)).to.eql(15);",
              "});",
              "pm.test('Field updated_at berubah', () => {",
              "  pm.expect(pm.response.json().data.updated_at).to.be.a('string');",
              "});"
            ]
          }
        }
