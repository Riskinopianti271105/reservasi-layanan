{
  "info": {
    "name": "Sistem Reservasi Layanan - API Test Collection",
    "_postman_id": "reservasi-layanan-api-tests",
    "description": "Automated API Tests untuk Sistem Reservasi Layanan\nMinimal 12 test cases sesuai ketentuan UTS",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "orderId", "value": "" }
  ],
  "item": [
    {
      "name": "0. Setup - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login berhasil', function() {",
              "  pm.response.to.have.status(200);",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.be.true;",
              "  pm.collectionVariables.set('token', json.data.token);",
              "  pm.environment.set('token', json.data.token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"username\": \"admin\", \"password\": \"password\"}" },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] }
      }
    },
    {
      "name": "TC-API-01: GET /api/products - Mengambil semua produk",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Validasi status code",
              "pm.test('Status code 200', () => pm.response.to.have.status(200));",
              "",
              "// Validasi content type",
              "pm.test('Content-Type adalah application/json', () => {",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "",
              "// Validasi response body",
              "pm.test('Response body memiliki field success, data, total', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property('success', true);",
              "  pm.expect(json).to.have.property('data');",
              "  pm.expect(json).to.have.property('total');",
              "  pm.expect(json.data).to.be.an('array');",
              "});",
              "",
              "// Validasi tipe data field",
              "pm.test('Setiap produk memiliki field wajib dengan tipe data benar', () => {",
              "  const json = pm.response.json();",
              "  if(json.data.length > 0) {",
              "    const p = json.data[0];",
              "    pm.expect(p.id).to.be.a('number');",
              "    pm.expect(p.name).to.be.a('string');",
              "    pm.expect(parseFloat(p.price)).to.be.a('number').and.above(0);",
              "    pm.expect(parseInt(p.stock)).to.be.a('number').and.at.least(0);",
              "    pm.collectionVariables.set('productId', p.id);",
              "  }",
              "});",
              "",
              "// Validasi JSON Schema",
              "pm.test('JSON Schema valid', () => {",
              "  const schema = {",
              "    type: 'object',",
              "    required: ['success', 'data', 'total'],",
              "    properties: {",
              "      success: { type: 'boolean' },",
              "      data: { type: 'array' },",
              "      total: { type: 'number' }",
              "    }",
              "  };",
              "  pm.response.to.have.jsonSchema(schema);",
              "});",
              "",
              "// Validasi response time",
              "pm.test('Response time < 2000ms', () => {",
              "  pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api","products"] }
      }
    },
    {
      "name": "TC-API-02: GET /api/products/:id - Detail produk ID valid",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code 200', () => pm.response.to.have.status(200));",
              "pm.test('Response memiliki data produk', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.be.true;",
              "  pm.expect(json.data).to.have.property('id');",
              "  pm.expect(json.data).to.have.property('name');",
              "  pm.expect(json.data).to.have.property('price');",
              "  pm.expect(json.data).to.have.property('stock');",
              "  pm.expect(json.data).to.have.property('category');",
              "});",
              "pm.test('ID produk sesuai request', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.data.id).to.be.a('number');",
              "  pm.expect(json.data.id).to.eql(parseInt(pm.environment.get('productId')));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api","products","{{productId}}"] }
      }
    },
    {
      "name": "TC-API-03: GET /api/products/:id - ID tidak ditemukan (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code 404', () => pm.response.to.have.status(404));",
              "pm.test('Response success adalah false', () => {",
              "  pm.expect(pm.response.json().success).to.be.false;",
              "});",
              "pm.test('Terdapat pesan kesalahan', () => {",
              "  pm.expect(pm.response.json().message).to.be.a('string').and.not.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/products/99999", "host": ["{{baseUrl}}"], "path": ["api","products","99999"] }
      }
    },
    {
      "name": "TC-API-04: POST /api/products - Membuat produk dengan payload valid",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code 201', () => pm.response.to.have.status(201));",
              "pm.test('Produk berhasil dibuat', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.be.true;",
              "  pm.expect(json.data).to.have.property('id');",
              "  pm.expect(json.data.name).to.eql('Layanan Test Otomatis');",
              "  pm.expect(parseFloat(json.data.price)).to.eql(75000);",
              "});",
              "pm.test('Content-Type adalah application/json', () => {",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Layanan Test Otomatis\", \"description\": \"Layanan untuk keperluan testing\", \"category\": \"Elektronik\", \"price\": 75000, \"stock\": 5}"
        },
        "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api","products"] }
      }
    },
