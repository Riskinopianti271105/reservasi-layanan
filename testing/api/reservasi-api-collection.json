    {
      "name": "TC-API-07: PATCH /api/products/:id - Memperbarui produk dengan payload valid",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code 200', () => pm.response.to.have.status(200));",
