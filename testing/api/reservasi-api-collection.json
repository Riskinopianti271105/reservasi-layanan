              "    properties: {",
              "      success: { type: 'boolean' },",
              "      data: {",
              "        type: 'object',",
              "        required: ['id','order_number','status','total_price','items']",
              "      }",
              "    }",
              "  };",
              "  pm.response.to.have.jsonSchema(schema);",
