      }
    },
    {
      "name": "TC-API-09: DELETE /api/products/:id - Menghapus produk",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.sendRequest({",
              "  url: pm.environment.get('baseUrl') + '/api/products',",
              "  method: 'POST',",
              "  header: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + pm.environment.get('token') },",
              "  body: { mode: 'raw', raw: JSON.stringify({ name: 'Produk Hapus Test', category: 'Elektronik', price: 10000, stock: 1 }) }",
              "}, (err, res) => { if(!err && res.json().data) pm.environment.set('deleteProductId', res.json().data.id); });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code 200', () => pm.response.to.have.status(200));",
              "pm.test('Produk berhasil dihapus', () => {",
              "  pm.expect(pm.response.json().success).to.be.true;",
              "  pm.expect(pm.response.json().message.toLowerCase()).to.include('dihapus');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{baseUrl}}/api/products/{{deleteProductId}}", "host": ["{{baseUrl}}"], "path": ["api","products","{{deleteProductId}}"] }
      }
    },
    {
      "name": "TC-API-10: POST /api/orders - Membuat pesanan dengan data valid",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Tambahkan produk ke keranjang sebelum buat pesanan",
              "const req = {",
              "  url: pm.environment.get('baseUrl') + '/api/cart',",
              "  method: 'POST',",
              "  header: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + pm.environment.get('token') },",
              "  body: { mode: 'raw', raw: JSON.stringify({ product_id: 5, quantity: 1 }) }",
              "};",
              "pm.sendRequest(req, (err, res) => {",
              "  if (err) console.log('Cart error:', err);",
              "  else console.log('Cart:', res.json().message);",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code 201', () => pm.response.to.have.status(201));",
              "pm.test('Pesanan berhasil dibuat', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.be.true;",
              "  pm.expect(json.data).to.have.property('id');",
              "  pm.expect(json.data).to.have.property('order_number');",
              "  pm.expect(json.data.status).to.eql('DRAFT');",
              "  pm.expect(json.data).to.have.property('total_price');",
              "  pm.expect(json.data).to.have.property('items');",
              "  pm.environment.set('orderId', json.data.id);",
              "});",
              "pm.test('Field wajib pesanan tersedia', () => {",
              "  const d = pm.response.json().data;",
              "  pm.expect(d.order_number).to.be.a('string');",
              "  pm.expect(d.receiver_name).to.eql('Budi Santoso');",
              "  pm.expect(d.status).to.eql('DRAFT');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
